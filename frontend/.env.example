# Frontend System Status — configuración opcional.
# En desarrollo con `npm run dev`, el proxy de Vite redirige /api y /ws
# al backend (no hace falta definir nada). Copia este archivo como `.env`
# solo si necesitas apuntar a otro backend.

# URL de la API REST (sin barras finales). Vacío = usar el proxy de Vite.
# VITE_API_BASE_URL=http://localhost:8000

# URL del WebSocket de métricas. Vacío = derivada de la URL actual.
# VITE_WS_URL=ws://localhost:8000/ws/metrics