# Backend System Status — configuración por variables de entorno.
# Copia este archivo como `.env` en `backend/` y ajusta los valores.

# Entorno: development | production
SYSSTATUS_ENV=development

# CORS: origenes del frontend (separados por coma)
SYSSTATUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seguridad (JWT) ------------------------------------------------------
# Habilita autenticación SOLO cuando tengas acceso controlado.
# En producción usa un secreto fuerte y cambia las contraseñas.
SYSSTATUS_AUTH_ENABLED=false
SYSSTATUS_ADMIN_USERNAME=admin
SYSSTATUS_ADMIN_PASSWORD=cambia-admin
SYSSTATUS_VIEWER_USERNAME=viewer
SYSSTATUS_VIEWER_PASSWORD=cambia-viewer
SYSSTATUS_JWT_SECRET=genera-un-secreto-largo-y-aleatorio
SYSSTATUS_JWT_ALGORITHM=HS256
SYSSTATUS_TOKEN_EXPIRE_MINUTES=60

# --- Tiempo real e histórico ----------------------------------------------
SYSSTATUS_WS_INTERVAL_SECONDS=2
SYSSTATUS_HISTORY_SNAPSHOT_SECONDS=15
SYSSTATUS_HISTORY_MAX_POINTS=3600
SYSSTATUS_MAX_PROCESSES=25
# Persistencia del histórico (SQLite). Ruta relativa al directorio backend/.
SYSSTATUS_HISTORY_DB_PATH=data/history.db
SYSSTATUS_HISTORY_RETENTION_DAYS=30

# --- Umbrales de alertas (porcentaje) -------------------------------------
SYSSTATUS_ALERT_CPU_WARNING=80
SYSSTATUS_ALERT_CPU_CRITICAL=90
SYSSTATUS_ALERT_MEMORY_WARNING=80
SYSSTATUS_ALERT_MEMORY_CRITICAL=90
SYSSTATUS_ALERT_DISK_WARNING=80
SYSSTATUS_ALERT_DISK_CRITICAL=90
# Segundos que un umbral debe superarse antes de disparar la alerta
# (evita falsas alarmas por picos momentáneos).
SYSSTATUS_ALERT_SUSTAIN_SECONDS=30

# --- Notificaciones (webhook genérico) -------------------------------------
# Una URL que acepte POST JSON sirve para Telegram, Discord, Slack, ntfy, etc.
# Vacío = notificaciones desactivadas.
SYSSTATUS_WEBHOOK_URL=
SYSSTATUS_WEBHOOK_TIMEOUT_SECONDS=10

# --- Tráfico mensual vs. cuota del plan -------------------------------------
# Cuota de transferencia del plan en GB. 0 = sin cuota configurada.
SYSSTATUS_TRAFFIC_QUOTA_GB=0
SYSSTATUS_TRAFFIC_WARNING_PERCENT=80
SYSSTATUS_TRAFFIC_CRITICAL_PERCENT=95

# --- Comprobaciones de disponibilidad ---------------------------------------
# Formato: nombre=objetivo, separados por coma. Esquemas: http(s):// y tcp://
# Ejemplo: nginx=http://localhost,api=https://api.example.com/health,ssh=tcp://127.0.0.1:22
SYSSTATUS_CHECKS=
SYSSTATUS_CHECKS_INTERVAL_SECONDS=30

# --- Score de anomalía --------------------------------------------------------
# Puntuación (0-100) que compara el comportamiento actual contra la línea
# base histórica. Un valor >= SYSSTATUS_ANOMALY_CRITICAL dispara alerta.
SYSSTATUS_ANOMALY_CRITICAL=80
SYSSTATUS_ANOMALY_WINDOW_MINUTES=120

# --- Servicios monitoreados ------------------------------------------------
SYSSTATUS_TRACKED_SERVICES=nginx,postgresql,redis,ssh,cron

# --- Rate limiting (preparado) ---------------------------------------------
SYSSTATUS_RATE_LIMIT_ENABLED=false
SYSSTATUS_RATE_LIMIT_PER_MINUTE=120

# --- Logging ----------------------------------------------------------------
SYSSTATUS_LOG_LEVEL=INFO
