# Backend System Status — configuración por variables de entorno.
# Copia este archivo como `.env` en `backend/` y ajusta los valores.

# Entorno: development | production
SYSSTATUS_ENV=development

# CORS: origenes del frontend (separados por coma)
SYSSTATUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seguridad (JWT) ------------------------------------------------------
# Habilita autenticación SOLO cuando tengas acceso controlado.
# En producción usa un secreto fuerte y cambia las contraseñas.
SYSSTATUS_AUTH_ENABLED=false
SYSSTATUS_ADMIN_USERNAME=admin
SYSSTATUS_ADMIN_PASSWORD=cambia-admin
SYSSTATUS_VIEWER_USERNAME=viewer
SYSSTATUS_VIEWER_PASSWORD=cambia-viewer
SYSSTATUS_JWT_SECRET=genera-un-secreto-largo-y-aleatorio
SYSSTATUS_JWT_ALGORITHM=HS256
SYSSTATUS_TOKEN_EXPIRE_MINUTES=60

# --- Tiempo real e histórico ----------------------------------------------
SYSSTATUS_WS_INTERVAL_SECONDS=2
SYSSTATUS_HISTORY_SNAPSHOT_SECONDS=15
SYSSTATUS_HISTORY_MAX_POINTS=3600
SYSSTATUS_MAX_PROCESSES=25

# --- Umbrales de alertas (porcentaje) -------------------------------------
SYSSTATUS_ALERT_CPU_WARNING=80
SYSSTATUS_ALERT_CPU_CRITICAL=90
SYSSTATUS_ALERT_MEMORY_WARNING=80
SYSSTATUS_ALERT_MEMORY_CRITICAL=90
SYSSTATUS_ALERT_DISK_WARNING=80
SYSSTATUS_ALERT_DISK_CRITICAL=90

# --- Servicios monitoreados ------------------------------------------------
SYSSTATUS_TRACKED_SERVICES=nginx,docker,postgresql,redis,ssh,cron

# --- Rate limiting (preparado) ---------------------------------------------
SYSSTATUS_RATE_LIMIT_ENABLED=false
SYSSTATUS_RATE_LIMIT_PER_MINUTE=120

# --- Logging ----------------------------------------------------------------
SYSSTATUS_LOG_LEVEL=INFO