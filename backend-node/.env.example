# Backend NestJS — misma configuración por variables SYSSTATUS_*
# Copia este archivo como `.env` en backend-node/ y ajusta los valores.

SYSSTATUS_ENV=development
# En VPS compartidos usa 8100 para no chocar con otros proyectos en 8000
SYSSTATUS_PORT=8100

SYSSTATUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Autenticación (JWT) ---
# En producción mantenla en true para proteger el panel y sus acciones.
SYSSTATUS_AUTH_ENABLED=true
SYSSTATUS_ADMIN_USERNAME=admin
SYSSTATUS_ADMIN_PASSWORD=cambia-admin
SYSSTATUS_VIEWER_USERNAME=viewer
SYSSTATUS_VIEWER_PASSWORD=cambia-viewer
SYSSTATUS_JWT_SECRET=genera-un-secreto-largo-y-aleatorio
SYSSTATUS_JWT_ALGORITHM=HS256
SYSSTATUS_TOKEN_EXPIRE_MINUTES=60

SYSSTATUS_WS_INTERVAL_SECONDS=2
SYSSTATUS_HISTORY_SNAPSHOT_SECONDS=15
SYSSTATUS_HISTORY_MAX_POINTS=3600
SYSSTATUS_MAX_PROCESSES=25
SYSSTATUS_HISTORY_DB_PATH=data/history.db
SYSSTATUS_HISTORY_RETENTION_DAYS=30

SYSSTATUS_ALERT_CPU_WARNING=80
SYSSTATUS_ALERT_CPU_CRITICAL=90
SYSSTATUS_ALERT_MEMORY_WARNING=80
SYSSTATUS_ALERT_MEMORY_CRITICAL=90
SYSSTATUS_ALERT_DISK_WARNING=80
SYSSTATUS_ALERT_DISK_CRITICAL=90
SYSSTATUS_ALERT_SUSTAIN_SECONDS=30

# --- Notificaciones ---
SYSSTATUS_WEBHOOK_URL=
SYSSTATUS_WEBHOOK_TIMEOUT_SECONDS=10

SYSSTATUS_TELEGRAM_BOT_TOKEN=
SYSSTATUS_TELEGRAM_CHAT_ID=

SYSSTATUS_SMTP_HOST=
SYSSTATUS_SMTP_PORT=587
SYSSTATUS_SMTP_USERNAME=
SYSSTATUS_SMTP_PASSWORD=
SYSSTATUS_SMTP_FROM_EMAIL=
SYSSTATUS_SMTP_TO_EMAILS=
SYSSTATUS_SMTP_USE_TLS=true

SYSSTATUS_TRAFFIC_QUOTA_GB=0
SYSSTATUS_TRAFFIC_WARNING_PERCENT=80
SYSSTATUS_TRAFFIC_CRITICAL_PERCENT=95

SYSSTATUS_CHECKS=
SYSSTATUS_CHECKS_INTERVAL_SECONDS=30

SYSSTATUS_ANOMALY_CRITICAL=80
SYSSTATUS_ANOMALY_WINDOW_MINUTES=120

SYSSTATUS_TRACKED_SERVICES=nginx,postgresql,redis,ssh,cron

SYSSTATUS_LOG_LEVEL=info